generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                 Int                   @id @default(autoincrement())
  fullName           String?
  mobile             String                @unique
  email              String?
  password           String
  role               String                @default("customer")
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  addresses          Address[]
  beautyProfile      BeautyProfile?
  cart               Cart?
  couponUsages       CouponUsage[]
  orders             Order[]
  orderStatusChanges OrderStatusHistory[]  @relation("OrderStatusActor")
  postexQuotes       PostexQuote[]
  refundsProcessed   Refund[]              @relation("RefundProcessor")
  returnRequests     ReturnRequest[]
  Session            Session[]
  stockMovements     StockMovement[]       @relation("StockMovementActor")
  tryOnSessions      VirtualTryOnSession[]
}

model Session {
  id               String    @id @default(uuid())
  userId           Int
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  logo      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([isActive])
}

model Product {
  id              Int                     @id @default(autoincrement())
  name            String
  englishName     String?
  slug            String                  @unique
  description     String?
  isActive        Boolean                 @default(true)
  brandId         Int?
  categoryId      Int?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  shortDesc       String?
  cartItems       CartItem[]
  competitorLinks CompetitorProductLink[]
  orderItems      OrderItem[]
  brand           Brand?                  @relation(fields: [brandId], references: [id])
  category        Category?               @relation(fields: [categoryId], references: [id])
  experience      ProductExperience?
  images          ProductImage[]
  intelligence    ProductIntelligence?
  priceInsight    ProductPriceInsight?
  shades          ProductShade[]
  variants        ProductVariant[]
  tryOnSessions   VirtualTryOnSession[]

  @@index([isActive, createdAt])
  @@index([brandId, isActive])
  @@index([categoryId, isActive])
}

model ProductVariant {
  id             Int             @id @default(autoincrement())
  title          String
  sku            String          @unique
  volume         Int?
  barcode        String?         @unique
  price          Decimal         @db.Decimal(18, 2)
  salePrice      Decimal?        @db.Decimal(18, 2)
  stock          Int             @default(0)
  isActive       Boolean         @default(true)
  productId      Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  heightCm       Int             @default(10)
  isFragile      Boolean         @default(false)
  isLiquid       Boolean         @default(false)
  lengthCm       Int             @default(10)
  weightGram     Int             @default(100)
  widthCm        Int             @default(10)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  shade          ProductShade?
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@index([productId, isActive])
  @@index([stock])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  alt       String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  productId Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model StockMovement {
  id            Int            @id @default(autoincrement())
  variantId     Int
  actorUserId   Int?
  delta         Int
  balanceBefore Int
  balanceAfter  Int
  reason        String?
  reference     String?
  createdAt     DateTime       @default(now())
  actor         User?          @relation("StockMovementActor", fields: [actorUserId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@index([actorUserId, createdAt])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        Int            @id @default(autoincrement())
  cartId    Int
  variantId Int
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  productId Int?
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product?       @relation(fields: [productId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model ShippingMethod {
  id               Int              @id @default(autoincrement())
  code             String           @unique
  title            String
  description      String?
  provider         ShippingProvider @default(post)
  flatRate         Decimal          @default(0) @db.Decimal(12, 0)
  freeAbove        Decimal?         @db.Decimal(18, 2)
  estimatedMinDays Int?
  estimatedMaxDays Int?
  isActive         Boolean          @default(true)
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  orders           Order[]

  @@index([isActive, sortOrder])
}

model Address {
  id             Int           @id @default(autoincrement())
  userId         Int
  title          String?
  receiverName   String
  receiverMobile String
  province       String
  city           String
  addressLine    String
  postalCode     String?
  plaque         String?
  unit           String?
  isDefault      Boolean       @default(false)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  postexCityId   Int?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         Order[]
  postexQuotes   PostexQuote[]
}

model ShippingOrigin {
  id           Int           @id @default(autoincrement())
  title        String
  senderName   String
  senderMobile String
  province     String
  city         String
  postexCityId Int
  addressLine  String
  postalCode   String?
  plaque       String?
  unit         String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  quotes       PostexQuote[]

  @@index([isActive, updatedAt])
}

model PostexQuote {
  id                String         @id @default(uuid())
  userId            Int
  addressId         Int
  originId          Int
  serviceCode       String
  courierCode       String?
  serviceName       String
  serviceType       String?
  providerPrice     Decimal        @db.Decimal(12, 0)
  internalExtraCost Decimal        @default(0) @db.Decimal(12, 0)
  customerPrice     Decimal        @db.Decimal(12, 0)
  estimatedDelivery String?
  boxTypeId         Int?
  packageCode       String?
  packageTitle      String?
  paymentType       String         @default("prepaid")
  pickupType        String         @default("pickup")
  insured           Boolean        @default(true)
  smsNotification   Boolean        @default(true)
  packaging         Boolean        @default(false)
  subtotalSnapshot  Decimal        @db.Decimal(18, 2)
  totalWeightGram   Int
  lengthCm          Int
  widthCm           Int
  heightCm          Int
  cartFingerprint   String
  requestSnapshot   Json?
  responseSnapshot  Json?
  expiresAt         DateTime
  consumedAt        DateTime?
  invalidatedAt     DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  order             Order?
  address           Address        @relation(fields: [addressId], references: [id], onDelete: Cascade)
  origin            ShippingOrigin @relation(fields: [originId], references: [id])
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([addressId, expiresAt])
  @@index([originId])
  @@index([serviceCode])
}

model PostexShipmentEvent {
  id             Int             @id @default(autoincrement())
  orderId        Int
  source         String
  providerStatus String?
  mappedStatus   ShippingStatus?
  payload        Json
  createdAt      DateTime        @default(now())
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([source, createdAt])
}

model Order {
  id                      Int                   @id @default(autoincrement())
  userId                  Int
  total                   Decimal               @default(0) @db.Decimal(18, 2)
  status                  OrderStatus           @default(pending)
  createdAt               DateTime              @default(now())
  authority               String?
  updatedAt               DateTime              @updatedAt
  addressId               Int?
  shippingAddressLine     String?
  shippingCity            String?
  shippingPlaque          String?
  shippingPostalCode      String?
  shippingProvince        String?
  shippingReceiverMobile  String?
  shippingReceiverName    String?
  shippingUnit            String?
  couponCode              String?
  couponId                Int?
  discountTotal           Decimal               @default(0) @db.Decimal(18, 2)
  payableTotal            Decimal               @default(0) @db.Decimal(18, 2)
  subtotal                Decimal               @default(0) @db.Decimal(18, 2)
  deliveredAt             DateTime?
  providerOrderId         String?
  shippedAt               DateTime?
  shippingCost            Decimal               @default(0) @db.Decimal(12, 0)
  shippingNote            String?
  shippingProvider        ShippingProvider?
  shippingStatus          ShippingStatus        @default(not_shipped)
  trackingCode            String?
  trackingUrl             String?
  postexBoxTypeId         Int?
  postexCityId            Int?
  postexCourierCode       String?
  postexEstimatedDelivery String?
  postexInternalExtraCost Decimal               @default(0) @db.Decimal(12, 0)
  postexPackageCode       String?
  postexPackageTitle      String?
  postexQuoteSnapshot     Json?
  postexServiceName       String?
  postexServiceType       String?
  postexShipmentSnapshot  Json?
  shipmentCreatedAt       DateTime?
  shipmentError           String?
  checkoutKey             String?               @unique
  reservationExpiresAt    DateTime?
  stockReleasedAt         DateTime?
  paidAt                  DateTime?
  canceledAt              DateTime?
  paymentRefId            String?
  paymentCardPan          String?
  shippingMethodId        Int?
  refundedTotal           Decimal               @default(0) @db.Decimal(18, 2)
  postexQuoteId           String?               @unique
  postexLabelUrl          String?
  postexInvoiceUrl        String?
  postexLastStatus        String?
  postexLastSyncedAt      DateTime?
  postexCanceledAt        DateTime?
  couponUsage             CouponUsage?
  invoice                 Invoice?
  address                 Address?              @relation(fields: [addressId], references: [id])
  coupon                  Coupon?               @relation(fields: [couponId], references: [id])
  postexQuote             PostexQuote?          @relation(fields: [postexQuoteId], references: [id])
  shippingMethod          ShippingMethod?       @relation(fields: [shippingMethodId], references: [id])
  user                    User                  @relation(fields: [userId], references: [id])
  items                   OrderItem[]
  statusHistory           OrderStatusHistory[]
  paymentAttempts         PaymentAttempt[]
  postexEvents            PostexShipmentEvent[]
  refunds                 Refund[]
  returnRequests          ReturnRequest[]

  @@index([couponId])
  @@index([couponCode])
  @@index([userId, createdAt])
  @@index([status, reservationExpiresAt])
  @@index([shippingMethodId])
  @@index([postexLastSyncedAt])
}

model PaymentAttempt {
  id          Int                  @id @default(autoincrement())
  orderId     Int
  authority   String               @unique
  amount      Decimal              @db.Decimal(18, 2)
  status      PaymentAttemptStatus @default(requested)
  gatewayCode Int?
  refId       String?
  cardPan     String?
  rawResponse Json?
  verifiedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  order       Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id           Int            @id @default(autoincrement())
  orderId      Int
  variantId    Int
  quantity     Int
  price        Decimal        @db.Decimal(18, 2)
  createdAt    DateTime       @default(now())
  productId    Int?
  productName  String         @default("")
  sku          String?
  total        Decimal        @default(0) @db.Decimal(18, 2)
  variantTitle String?
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?       @relation(fields: [productId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  returnItems  ReturnItem[]
}

model Coupon {
  id                Int           @id @default(autoincrement())
  code              String        @unique
  title             String?
  description       String?
  type              CouponType    @default(percent)
  value             Decimal       @db.Decimal(18, 2)
  maxDiscount       Decimal?      @db.Decimal(18, 2)
  minOrderAmount    Decimal       @default(0) @db.Decimal(18, 2)
  usageLimit        Int?
  usageLimitPerUser Int?
  usedCount         Int           @default(0)
  startsAt          DateTime?
  expiresAt         DateTime?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  usages            CouponUsage[]
  orders            Order[]

  @@index([isActive])
  @@index([expiresAt])
}

model CouponUsage {
  id             Int       @id @default(autoincrement())
  couponId       Int
  userId         Int
  orderId        Int       @unique
  discountAmount Decimal   @db.Decimal(18, 2)
  createdAt      DateTime  @default(now())
  releasedAt     DateTime?
  coupon         Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id])

  @@index([couponId])
  @@index([userId])
}

model OrderStatusHistory {
  id          Int          @id @default(autoincrement())
  orderId     Int
  actorUserId Int?
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  metadata    Json?
  createdAt   DateTime     @default(now())
  actor       User?        @relation("OrderStatusActor", fields: [actorUserId], references: [id])
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([actorUserId, createdAt])
}

model ReturnRequest {
  id                Int                 @id @default(autoincrement())
  returnNumber      String              @unique
  orderId           Int
  userId            Int
  status            ReturnRequestStatus @default(requested)
  reason            String
  customerNote      String?
  adminNote         String?
  requestedAt       DateTime            @default(now())
  approvedAt        DateTime?
  rejectedAt        DateTime?
  receivedAt        DateTime?
  refundRequestedAt DateTime?
  refundedAt        DateTime?
  canceledAt        DateTime?
  restockedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  refund            Refund?
  items             ReturnItem[]
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ReturnItem {
  id              Int           @id @default(autoincrement())
  returnRequestId Int
  orderItemId     Int
  quantity        Int
  reason          String?
  createdAt       DateTime      @default(now())
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

model Refund {
  id                Int            @id @default(autoincrement())
  refundNumber      String         @unique
  orderId           Int
  returnRequestId   Int?           @unique
  processedByUserId Int?
  amount            Decimal        @db.Decimal(18, 2)
  status            RefundStatus   @default(pending)
  reason            String?
  gatewayReference  String?
  adminNote         String?
  rawResponse       Json?
  requestedAt       DateTime       @default(now())
  processedAt       DateTime?
  succeededAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  processedBy       User?          @relation("RefundProcessor", fields: [processedByUserId], references: [id])
  returnRequest     ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model Invoice {
  id              Int           @id @default(autoincrement())
  invoiceNumber   String        @unique
  orderId         Int           @unique
  status          InvoiceStatus @default(issued)
  subtotal        Decimal       @db.Decimal(18, 2)
  discountTotal   Decimal       @default(0) @db.Decimal(18, 2)
  shippingCost    Decimal       @default(0) @db.Decimal(12, 0)
  payableTotal    Decimal       @db.Decimal(18, 2)
  refundedTotal   Decimal       @default(0) @db.Decimal(18, 2)
  customerName    String?
  customerMobile  String?
  customerAddress String?
  issuedAt        DateTime      @default(now())
  voidedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, issuedAt])
}

model ProductShade {
  id            Int                   @id @default(autoincrement())
  productId     Int
  variantId     Int?                  @unique
  name          String
  code          String?
  hexColor      String?
  region        ProductRegionType
  finish        ProductShadeFinish?
  opacity       Float?
  previewImage  String?
  sortOrder     Int                   @default(0)
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant?       @relation(fields: [variantId], references: [id])
  tryOnSessions VirtualTryOnSession[]
}

model ProductIntelligence {
  id                      Int      @id @default(autoincrement())
  productId               Int      @unique
  aiGeneratedTitle        String?
  aiGeneratedShortDesc    String?
  aiGeneratedDescription  String?
  seoTitle                String?
  seoDescription          String?
  seoKeywords             String[]
  storyTitle              String?
  storyText               String?
  howToUse                String?
  warnings                String?
  suitableFor             String[]
  ingredients             String[]
  benefits                String[]
  complementaryProductIds Int[]
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  product                 Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductExperience {
  id             Int      @id @default(autoincrement())
  productId      Int      @unique
  visualTheme    String?
  mood           String?
  colorPalette   String[]
  motionPreset   String?
  heroVideoUrl   String?
  threeDModelUrl String?
  arModelUrl     String?
  scentFamily    String?
  topNotes       String[]
  middleNotes    String[]
  baseNotes      String[]
  season         String[]
  occasion       String[]
  gender         String?
  longevity      String?
  sillage        String?
  skinTypes      String[]
  routineStep    String?
  texture        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model BeautyProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  skinType        String?
  undertone       String?
  scentFamilies   String[]
  favoriteNotes   String[]
  allergies       String[]
  preferredBrands String[]
  budgetMin       Decimal? @db.Decimal(18, 2)
  budgetMax       Decimal? @db.Decimal(18, 2)
  beautyGoals     String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VirtualTryOnSession {
  id              Int                   @id @default(autoincrement())
  userId          Int
  productId       Int
  shadeId         Int?
  region          ProductRegionType?
  sourceImageUrl  String?
  resultImageUrl  String?
  status          TryOnStatus           @default(pending)
  errorMessage    String?
  consentAccepted Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  shade           ProductShade?         @relation(fields: [shadeId], references: [id])
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  VirtualTryOnJob VirtualTryOnJob[]
  analysis        VirtualTryOnAnalysis?
}

model VirtualTryOnJob {
  id Int @id @default(autoincrement())

  sessionId Int

  type   VirtualTryOnJobType
  status VirtualTryOnJobStatus @default(queued)

  startedAt  DateTime?
  finishedAt DateTime?

  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session VirtualTryOnSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status])
}

model VirtualTryOnAnalysis {
  id Int @id @default(autoincrement())

  sessionId Int @unique

  faceDetected Boolean @default(false)

  landmarks Json?

  lipMaskUrl String?

  skinMaskUrl String?

  eyeMaskUrl String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  session VirtualTryOnSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Competitor {
  id                   Int                     @id @default(autoincrement())
  name                 String
  slug                 String                  @unique
  websiteUrl           String?
  isActive             Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  availabilitySelector String?
  priceMultiplier      Float                   @default(1)
  priceSelector        String?
  salePriceSelector    String?
  titleSelector        String?
  productLinks         CompetitorProductLink[]
}

model CompetitorProductLink {
  id           Int             @id @default(autoincrement())
  productId    Int
  competitorId Int
  url          String
  title        String?
  externalSku  String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  competitor   Competitor      @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  snapshots    PriceSnapshot[]
}

model PriceSnapshot {
  id                      Int                   @id @default(autoincrement())
  competitorProductLinkId Int
  price                   Decimal               @db.Decimal(18, 2)
  salePrice               Decimal?              @db.Decimal(18, 2)
  currency                String                @default("IRR")
  isAvailable             Boolean               @default(true)
  source                  PriceSnapshotSource   @default(manual)
  capturedAt              DateTime              @default(now())
  competitorProductLink   CompetitorProductLink @relation(fields: [competitorProductLinkId], references: [id], onDelete: Cascade)
}

model ProductPriceInsight {
  id                Int               @id @default(autoincrement())
  productId         Int               @unique
  feloralPrice      Decimal           @db.Decimal(18, 2)
  minMarketPrice    Decimal?          @db.Decimal(18, 2)
  avgMarketPrice    Decimal?          @db.Decimal(18, 2)
  maxMarketPrice    Decimal?          @db.Decimal(18, 2)
  suggestedPrice    Decimal?          @db.Decimal(18, 2)
  insightLevel      PriceInsightLevel @default(unknown)
  summary           String?
  recommendedAction String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  group     String   @default("general")
  value     Json
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@index([isPublic])
}

model ThemeSetting {
  id              Int      @id @default(1)
  name            String   @default("default")
  primaryFont     String   @default("Vazirmatn")
  headingFont     String   @default("Vazirmatn")
  bodyFont        String   @default("Vazirmatn")
  buttonFont      String   @default("Vazirmatn")
  accentColor     String   @default("#d6a84f")
  backgroundColor String   @default("#f6f0e8")
  textColor       String   @default("#101010")
  darkColor       String   @default("#070707")
  logoText        String   @default("FELORAL")
  logoImageId     Int?
  availableFonts  Json?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MediaAsset {
  id           Int               @id @default(autoincrement())
  key          String?           @unique
  url          String
  filename     String?
  originalName String?
  mimeType     String?
  sizeBytes    Int?
  alt          String?
  title        String?
  description  String?
  width        Int?
  height       Int?
  isPublic     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  contents     EditableContent[]

  @@index([isPublic])
}

model HomepageSection {
  id         Int                   @id @default(autoincrement())
  key        String                @unique
  type       HomepageSectionType   @default(custom)
  status     HomepageSectionStatus @default(published)
  title      String?
  sortOrder  Int                   @default(0)
  settings   Json?
  isEditable Boolean               @default(true)
  isPublic   Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  contents   EditableContent[]

  @@index([status])
  @@index([isPublic])
  @@index([sortOrder])
}

model EditableContent {
  id          Int                 @id @default(autoincrement())
  key         String              @unique
  type        EditableContentType @default(text)
  title       String?
  plainText   String?
  value       Json?
  sectionId   Int?
  mediaId     Int?
  fontFamily  String?
  fontWeight  String?
  color       String?
  isPublic    Boolean             @default(true)
  isEditable  Boolean             @default(true)
  updatedById Int?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  media       MediaAsset?         @relation(fields: [mediaId], references: [id])
  section     HomepageSection?    @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([mediaId])
  @@index([isPublic])
}

