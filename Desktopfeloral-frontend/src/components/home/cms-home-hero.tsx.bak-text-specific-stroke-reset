      <div className="luxury-container">
        <div data-feloral-hero="true" className="relative min-h-[352px] overflow-hidden rounded-2xl border border-white/12 bg-[#090909] ref-hero-shadow">
          {currentBackground ? (
            <img key={`${activeIndex}-${currentBackground}`} src={currentBackground} alt={`Feloral hero slide ${activeIndex + 1}`} className="absolute inset-0 z-0 h-full w-full object-cover" style={{ objectFit: "cover", width: "100%", height: "100%", maxWidth: "none", minWidth: "100%", minHeight: "100%" }} />
          ) : null}
          {!currentBackground ? (
            <>
              <div className="absolute inset-0 z-0 bg-[radial-gradient(circle_at_18%_50%,rgba(214,168,79,.25),transparent_17rem)]" />
              <div className="absolute inset-0 z-0 bg-gradient-to-l from-black/88 via-black/54 to-black/18" />
            </>
          ) : (
            <>
              <div className="absolute inset-0 z-[1] bg-[radial-gradient(circle_at_18%_50%,rgba(214,168,79,.18),transparent_17rem)]" />
              <div className="absolute inset-0 z-[1] bg-gradient-to-l from-black/78 via-black/42 to-black/8" />
            </>
          )}
          {HERO_SLIDES.map((slide) => (
            <CmsImageEditButton key={slide.backgroundKey} cmsKey={slide.backgroundKey} sectionKey="home.hero" label={slide.backgroundLabel} currentUrl={slides[slide.index] || ""} className={slide.backgroundButtonClassName} />
