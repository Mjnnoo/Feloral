              <p data-feloral-hero-drag="subtitle" className="mt-4 whitespace-pre-line text-[19px] font-medium leading-9 text-white/88" style={activeStrokeStyle}>
                <CmsEditMarker cmsKey={activeSlide.subtitleKey} sectionKey="home.hero" label={`زیرعنوان هیرو ${activeIndex + 1}`}>{subtitle}</CmsEditMarker>
              </p>
              <Link data-feloral-hero-drag="cta" href="/shop" className="mt-6 inline-flex items-center gap-2 rounded-lg px-7 py-3 text-sm font-extrabold text-black transition hover:brightness-110" style={{ backgroundColor: accentColor, ...activeStrokeStyle }}>
                <CmsEditMarker cmsKey={activeSlide.ctaKey} sectionKey="home.hero" label={`متن دکمه هیرو ${activeIndex + 1}`}>{cta}</CmsEditMarker>
                <ChevronLeft size={18} />
              </Link>
            </div>
          </div>
          <div className="absolute bottom-6 left-1/2 z-20 flex -translate-x-1/2 gap-2">
            {HERO_SLIDES.map((slide) => (
              <button key={slide.backgroundKey} type="button" onClick={() => goToSlide(slide.index)} className="h-2 w-2 rounded-full transition" style={{ backgroundColor: slide.index === activeIndex ? accentColor : "rgba(255,255,255,.38)", transform: slide.index === activeIndex ? "scale(1.22)" : "scale(1)" }} aria-label={`تصویر ${slide.index + 1} هیرو`} />
            ))}
          </div>
        </div>
      </div>
    </section>
