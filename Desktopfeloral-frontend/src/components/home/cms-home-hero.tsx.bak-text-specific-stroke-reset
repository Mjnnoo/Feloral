            <ChevronRight size={32} strokeWidth={1.6} />
          </button>
          <button type="button" onClick={() => goToSlide(activeIndex + 1)} className="absolute left-6 top-1/2 z-20 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full text-white transition hover:bg-white/10" aria-label="تصویر بعدی هیرو">
            <ChevronLeft size={32} strokeWidth={1.6} />
          </button>
          <div className="relative z-10 flex min-h-[352px] items-center justify-end px-16 text-right">
            <div className="max-w-[620px]">
              <p data-feloral-hero-drag="eyebrow" className="text-[18px] font-extrabold" style={{ color: accentColor, ...activeStrokeStyle }}>
                <CmsEditMarker cmsKey={activeSlide.eyebrowKey} sectionKey="home.hero" label={`متن کوچک هیرو ${activeIndex + 1}`}>{eyebrow}</CmsEditMarker>
