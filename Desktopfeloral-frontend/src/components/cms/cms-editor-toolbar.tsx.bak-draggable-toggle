"use client";

import { useCmsEditor } from "./cms-editor-provider";

export function CmsEditorToolbar() {
  const { enabled, enableEditor, disableEditor, selected } = useCmsEditor();

  if (!enabled) {
    return (
      <button
        type="button"
        onClick={enableEditor}
        style={{
          position: "fixed",
          right: 18,
          bottom: 18,
          zIndex: 9999,
          border: 0,
          borderRadius: 999,
          background: "#d6a84f",
          color: "#050505",
          padding: "12px 18px",
          fontSize: 12,
          fontWeight: 900,
          cursor: "pointer",
          boxShadow: "0 16px 35px rgba(0,0,0,.25)"
        }}
      >
        فعال‌سازی ادیتور
      </button>
    );
  }

  return (
    <div
      dir="rtl"
      style={{
        position: "fixed",
        right: 18,
        top: 18,
        zIndex: 10001,
        display: "flex",
        gap: 8,
        alignItems: "center",
        maxWidth: "calc(100vw - 430px)",
        pointerEvents: "auto"
      }}
    >
      <button
        type="button"
        style={{
          border: 0,
          borderRadius: 999,
          background: "#d6a84f",
          color: "#050505",
          padding: "10px 14px",
          fontSize: 12,
          fontWeight: 900,
          boxShadow: "0 16px 35px rgba(0,0,0,.20)"
        }}
      >
        ادیتور فعال است
      </button>

      <span
        style={{
          maxWidth: 260,
          overflow: "hidden",
          textOverflow: "ellipsis",
          whiteSpace: "nowrap",
          borderRadius: 999,
          background: "#fff",
          color: "#111",
          padding: "10px 14px",
          fontSize: 12,
          fontWeight: 900,
          boxShadow: "0 16px 35px rgba(0,0,0,.16)"
        }}
      >
        {selected ? selected.key : "روی یک متن یا تصویر کلیک کن"}
      </span>

      <button
        type="button"
        onClick={disableEditor}
        style={{
          border: 0,
          borderRadius: 999,
          background: "#1f1f1f",
          color: "#fff",
          padding: "10px 14px",
          fontSize: 12,
          fontWeight: 900,
          cursor: "pointer",
          boxShadow: "0 16px 35px rgba(0,0,0,.20)"
        }}
      >
        خروج
      </button>
    </div>
  );
}
